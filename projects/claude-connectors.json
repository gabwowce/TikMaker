        "headline": "THEN CLAUDE CAN WORK WITH THEM."
      },
      "visual": {
        "type": "prop",
        "asset": "browser-window"
      },
      "motion": {
        "entrance": "fade"
      }
    },
    {
      "id": "takeaway",
      "type": "takeaway",
      "durationSeconds": 3,
      "background": "spotlight",
      "content": {
        "headline": "CLAUDE IS BECOMING MORE THAN A CODE GENERATOR."
      },
      "motion": {
        "entrance": "slideUp"
      }
    }
  ]
