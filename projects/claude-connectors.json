{
  "id": "claude-connectors",
  "title": "Claude Code Can Use Other Apps",
  "fps": 30,
  "width": 1080,
  "height": 1920,

  "scenes": [
    {
      "id": "hook",
      "type": "hook-visual",
      "durationSeconds": 3,
      "background": "orange-glow",
