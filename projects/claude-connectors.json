        "headline": "CLAUDE CODE CAN USE OTHER APPS."
      },
      "visual": {
        "type": "tool-logo",
        "tool": "claude"
      },
      "motion": {
        "entrance": "slideUp"
      }
    },
    {
      "id": "flow",
      "type": "visual-explainer",
      "durationSeconds": 4.5,
      "background": "soft-grid",
      "content": {
        "headline": "CONNECT YOUR TOOLS",
        "body": "Claude works alongside the tools you already use."
      },
      "visual": {
        "type": "tool-flow",
        "tools": ["github", "claude", "supabase"]
      },
      "motion": {
        "entrance": "fade"
      }
    },
    {
      "id": "demo",
      "type": "screen-demo",
      "durationSeconds": 5,
      "background": "solid-dark",
