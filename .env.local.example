TIKMAKER_AI_PATH=./ai
TIKMAKER_PROPS_PATH=./props
TIKMAKER_SFX_PATH=./sfx
TIKMAKER_FONTS_PATH=./fonts

# ElevenLabs text-to-speech. The key is read by the DEV SERVER only and never
# reaches the browser. Create one in your ElevenLabs account under API Keys.
ELEVENLABS_API_KEY=
# Optional. Unset falls back to the defaults baked into scripts/voiceApi.ts.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# The agent through Claude Code (server/agent/claudeCode.ts). The pictures
# are written as code by Claude Code with the skills in .claude/skills/
# (step "writeCode" runs on opus by default – server/agent/models.ts).
AGENT_PROVIDER=claude-code
# CLAUDE_CODE_PATH=            where claude(.exe) is
# AGENT_CLAUDE_KEEP_ENV=1      keep ANTHROPIC_BASE_URL & co. for the child
#                              (a cloud sandbox); unset on your own machine
# REMOTION_BROWSER_EXECUTABLE= a Chrome of the machine's own for renders
#                              and stills (unset: Remotion downloads its own)
