TIKMAKER_AI_PATH=./ai
TIKMAKER_PROPS_PATH=./props
TIKMAKER_SFX_PATH=./sfx
TIKMAKER_FONTS_PATH=./fonts

# ElevenLabs text-to-speech. The key is read by the DEV SERVER only and never
# reaches the browser. Create one in your ElevenLabs account under API Keys.
ELEVENLABS_API_KEY=
# Optional. Unset falls back to the defaults baked into scripts/voiceApi.ts.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
